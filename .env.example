# نمونه تنظیمات — کپی کن به .env و مقادیر را پر کن
# cp .env.example .env

# --- هویت ---
BOT_NAME=آسترا
BOT_USERNAME=AstraToolsBot
BOT_TAGLINE=همه ابزارها در یک ربات ✨

# توکن از @BotFather در روبیکا (برای اجرا روی روبیکا)
BOT_TOKEN=

# توکن از @BotFather در تلگرام (قالب: 123456789:AA... — برای اجرا روی تلگرام)
TELEGRAM_BOT_TOKEN=

# auto | rubika | telegram   (در auto از روی قالب توکن تشخیص داده می‌شود)
PLATFORM=auto

# --- ادمین‌ها (شناسه کاربری روبیکا؛ با /id در ربات بگیر) ---
ADMIN_IDS=
SUPPORT_ID=

# --- هوش مصنوعی (اختیاری؛ هر سرویس OpenAI-like) ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_IMAGE_URL=https://image.pollinations.ai/prompt

# --- عضویت ویژه ---
VIP_PRICE_1=۴۹,۰۰۰ تومان
VIP_PRICE_3=۱۲۹,۰۰۰ تومان
VIP_PRICE_6=۲۲۹,۰۰۰ تومان
CARD_NUMBER=
CARD_OWNER=

# --- عملکرد ---
POLL_INTERVAL=2
REQUEST_TIMEOUT=15
UPDATE_LIMIT=50
WORKERS=8
MAX_UPLOAD_MB=45

# --- سرویس‌های جانبی ---
OCR_API_KEY=helloworld
OCR_LANG=fas
TTS_LANG=fa
